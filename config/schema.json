{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WasteVLMAnnotation",
  "description": "Unified annotation schema for a single image in the Waste VLM Dataset.",
  "type": "object",
  "required": ["image_id", "file_name", "source_dataset", "split", "width", "height", "objects"],
  "properties": {
    "image_id": {
      "type": "string",
      "description": "Unique image identifier, e.g. taco_000142 or zw_001023."
    },
    "file_name": {
      "type": "string",
      "description": "Relative path to the processed image file."
    },
    "source_dataset": {
      "type": "string",
      "enum": ["TACO", "ZeroWaste", "COCO", "custom"]
    },
    "split": {
      "type": "string",
      "enum": ["train", "val", "test"]
    },
    "width":  { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "scene_context": {
      "type": "string",
      "enum": [
        "isolated_clean_background",
        "outdoor_natural_litter",
        "urban_pavement",
        "high_clutter_conveyor_pile",
        "indoor_bin_area"
      ]
    },
    "scene_caption_blip2": { "type": "string", "default": "" },
    "scene_caption_qwen":  { "type": "string", "default": "" },
    "verified_scene_caption": { "type": "string", "default": "" },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object_id", "bbox", "original_label", "structured_attributes"],
        "properties": {
          "object_id": { "type": "string" },
          "bbox": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x, y, width, height] in pixels."
          },
          "segmentation": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" }
            }
          },
          "original_label": { "type": "string" },
          "structured_attributes": {
            "type": "object",
            "required": ["category", "material"],
            "properties": {
              "category": { "type": "string" },
              "material": { "type": "string" },
              "condition": {
                "type": "array",
                "items": { "type": "string" }
              },
              "spatial_location": { "type": "string" },
              "sorting_action":   { "type": "string" }
            }
          },
          "candidate_captions": {
            "type": "object",
            "properties": {
              "blip2":      { "type": "string", "default": "" },
              "qwen2_5_vl": { "type": "string", "default": "" },
              "llava":      { "type": "string", "default": "" }
            }
          },
          "metrics": {
            "type": "object",
            "properties": {
              "clip_score_blip2": { "type": "number", "default": 0.0 },
              "clip_score_qwen":  { "type": "number", "default": 0.0 }
            }
          },
          "human_review": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["pending", "approved", "rejected", "needs_edit"],
                "default": "pending"
              },
              "verified_caption": { "type": "string", "default": "" },
              "sorting_instruction": { "type": "string", "default": "" },
              "hallucination_flagged": { "type": "boolean", "default": false }
            }
          }
        }
      }
    }
  }
}
